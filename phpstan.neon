parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - src/Kernel.php
    reportUnmatchedIgnoredErrors: false
    symfony:
        containerXmlPath: '%rootDir%/../../../var/cache/dev/App_KernelDevDebugContainer.xml'
    doctrine:
        objectManagerLoader: tests/doctrine-object-manager.php
    ignoreErrors:
        # Ignore errors from generated entity getters/setters
        - '#Call to an undefined method App\\Entity\\[a-zA-Z]+::[gs]et#'
        # Ignore Stripe SDK return types that might be mixed
        - '#Parameter \#1 \$[a-zA-Z]+ of method Stripe\\[a-zA-Z\\\\]+::[a-zA-Z]+ expects [^,]+, mixed given#'
        # Ignore form component mixed returns
        - '#Cannot call method [a-zA-Z]+ on Symfony\\Component\\Form\\FormInterface\|null#'
        # Ignore Doctrine property type mapping mismatches for required columns
        - '#Property App\\Entity\\[a-zA-Z]+::\$[a-zA-Z]+ type mapping mismatch#'
        # Ignore Doctrine association type mapping mismatches
        - '#Property App\\Entity\\[a-zA-Z]+::\$[a-zA-Z]+ type mapping mismatch.*association.*#'
        # Ignore JSON_CONTAINS function not recognized by DQL
        - '#QueryBuilder.*JSON_CONTAINS.*#'
        # Ignore missing value type for array properties in entities
        - '#Property App\\Entity\\[a-zA-Z]+::\$[a-zA-Z]+ type has no value type specified in iterable type array#'
        # Ignore missing value type specifications
        - '#has no value type specified in iterable type array#'
        # Ignore parameter array type specifications
        - '#has parameter \$[a-zA-Z]+ with no value type specified in iterable type array#'
        # Ignore Stripe Invoice subscription property access
        - '#Access to an undefined property Stripe\\Invoice::\$subscription#'
        # Ignore false return type from date diff
        - '#should return int\|null but returns int\|false#'
        # Ignore non-empty-string requirement for user identifier
        - '#should return non-empty-string but returns string#'
        # Ignore missing generic types for form classes
        - '#Class App\\Form\\[a-zA-Z]+FormType extends generic class.*but does not specify its types#'