{% extends 'base.html.twig' %}

{% block title %}COBOLCOBOL - Premium SaaS Content Platform{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-4">
                        Welcome to COBOLCOBOL
                    </h1>
                    <p class="lead mb-5">
                        Access premium content and exclusive articles with our subscription-based platform.
                        Join thousands of subscribers who trust COBOLCOBOL for quality content.
                    </p>
                    {% if not app.user %}
                        <div class="d-grid gap-2 d-md-block">
                            <a href="{{ path('app_register') }}" class="btn btn-light btn-lg px-5 me-3">
                                <i class="bi bi-person-plus"></i> Get Started Free
                            </a>
                            <a href="{{ path('app_pricing') }}" class="btn btn-outline-light btn-lg px-5">
                                <i class="bi bi-eye"></i> View Pricing
                            </a>
                        </div>
                    {% else %}
                        <div class="d-grid gap-2 d-md-block">
                            <a href="{{ path('app_dashboard') }}" class="btn btn-light btn-lg px-5 me-3">
                                <i class="bi bi-speedometer2"></i> Go to Dashboard
                            </a>
                            {% if not is_granted('ROLE_SUBSCRIBER') %}
                                <a href="{{ path('app_pricing') }}" class="btn btn-outline-light btn-lg px-5">
                                    <i class="bi bi-star"></i> Upgrade to Premium
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-lg-12">
                    <h2 class="display-5 fw-bold">Why Choose COBOLCOBOL?</h2>
                    <p class="lead text-muted">Premium features designed for content lovers</p>
                </div>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-journal-text text-white fs-2"></i>
                        </div>
                        <h4>Premium Articles</h4>
                        <p class="text-muted">Access exclusive, high-quality articles written by industry experts.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-shield-check text-white fs-2"></i>
                        </div>
                        <h4>Secure & Reliable</h4>
                        <p class="text-muted">Your data is protected with enterprise-grade security and reliability.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-lightning-charge text-white fs-2"></i>
                        </div>
                        <h4>Fast & Modern</h4>
                        <p class="text-muted">Built with modern technology for the best user experience.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Articles Section -->
    {% if recent_articles %}
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-12 text-center">
                    <h2 class="display-6 fw-bold">Latest Articles</h2>
                    <p class="lead text-muted">Discover our most recent content</p>
                </div>
            </div>
            <div class="row g-4">
                {% for article in recent_articles %}
                <div class="col-md-4">
                    <div class="card h-100 {% if article.isPremium %}card-premium{% endif %}">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">{{ article.title }}</h5>
                                {% if article.isPremium %}
                                    <span class="premium-badge">
                                        <i class="bi bi-star-fill"></i> Premium
                                    </span>
                                {% endif %}
                            </div>
                            <p class="card-text text-muted">{{ article.preview(120) }}</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i> {{ article.readingTime }} min read
                                </small>
                                <small class="text-muted">
                                    {{ article.publishedAt ? article.publishedAt.format('M d, Y') : 'Draft' }}
                                </small>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            {% if article.isPremium and not is_granted('ROLE_SUBSCRIBER') %}
                                <a href="{{ path('app_pricing') }}" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-lock"></i> Upgrade to Read
                                </a>
                            {% else %}
                                <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="btn btn-primary btn-sm">
                                    <i class="bi bi-arrow-right"></i> Read Article
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="text-center mt-4">
                <a href="{{ path('app_articles') }}" class="btn btn-outline-primary">
                    <i class="bi bi-collection"></i> View All Articles
                </a>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Pricing Preview -->
    {% if plans %}
    <section class="py-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-12 text-center">
                    <h2 class="display-6 fw-bold">Simple Pricing</h2>
                    <p class="lead text-muted">Choose the plan that's right for you</p>
                </div>
            </div>
            <div class="row justify-content-center g-4">
                {% for plan in plans|slice(0, 2) %}
                <div class="col-md-5">
                    <div class="card pricing-card h-100 {% if loop.last %}featured{% endif %}">
                        <div class="card-body text-center p-4">
                            <h5 class="card-title">{{ plan.name }}</h5>
                            <div class="my-4">
                                <span class="display-4 fw-bold">{{ plan.formattedPriceMonthly }}</span>
                                <small class="text-muted">/month</small>
                            </div>
                            <p class="text-muted">{{ plan.description }}</p>
                            {% if not app.user %}
                                <a href="{{ path('app_register') }}" class="btn {% if loop.last %}btn-primary{% else %}btn-outline-primary{% endif %} btn-lg w-100">
                                    Get Started
                                </a>
                            {% elseif not is_granted('ROLE_SUBSCRIBER') %}
                                <a href="{{ path('app_subscribe', {id: plan.id}) }}" class="btn {% if loop.last %}btn-primary{% else %}btn-outline-primary{% endif %} btn-lg w-100">
                                    Subscribe Now
                                </a>
                            {% else %}
                                <button class="btn btn-success btn-lg w-100" disabled>
                                    <i class="bi bi-check-circle"></i> Subscribed
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="text-center mt-4">
                <a href="{{ path('app_pricing') }}" class="btn btn-outline-primary">
                    <i class="bi bi-list-ul"></i> View All Plans
                </a>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- CTA Section -->
    {% if not app.user %}
    <section class="py-5 bg-primary text-white">
        <div class="container text-center">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h2 class="display-6 fw-bold mb-4">Ready to Get Started?</h2>
                    <p class="lead mb-4">
                        Join COBOLCOBOL today and unlock access to premium content,
                        exclusive articles, and a community of like-minded individuals.
                    </p>
                    <a href="{{ path('app_register') }}" class="btn btn-light btn-lg px-5">
                        <i class="bi bi-person-plus"></i> Create Your Account
                    </a>
                </div>
            </div>
        </div>
    </section>
    {% endif %}
{% endblock %}