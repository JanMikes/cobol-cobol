{% extends 'base.html.twig' %}

{% block title %}Čo bol COBOL? - Moderná COBOL vývojárska platforma{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden gradient-bg">
        <!-- Animated background grid -->
        <div class="absolute inset-0 matrix-bg opacity-30"></div>

        <!-- Floating code elements -->
        <div class="floating-code absolute top-16 left-8 opacity-25 animate-float hidden md:block">
            <div class="terminal-window w-80">
                <div class="terminal-header">
                    <span class="terminal-dot dot-red"></span>
                    <span class="terminal-dot dot-yellow"></span>
                    <span class="terminal-dot dot-green"></span>
                    <span class="text-white/60 text-xs ml-4 font-mono">HELLO-WORLD.cbl</span>
                </div>
                <div class="p-4 font-mono text-xs space-y-1">
                    <div class="text-cobol-cyan">IDENTIFICATION DIVISION.</div>
                    <div class="text-terminal-text">PROGRAM-ID. HELLO-WORLD.</div>
                    <div class="text-terminal-text">AUTHOR. COBOL DEVELOPER.</div>
                    <div></div>
                    <div class="text-cobol-green">DATA DIVISION.</div>
                    <div class="text-cobol-green">WORKING-STORAGE SECTION.</div>
                    <div class="text-terminal-text">01 <span class="text-cobol-amber">WS-MESSAGE</span> <span class="syntax-keyword">PIC</span> <span class="text-cobol-amber">X(30)</span></div>
                    <div class="text-terminal-text">   <span class="syntax-keyword">VALUE</span> <span class="syntax-string">'Hello, COBOL World!'</span>.</div>
                    <div></div>
                    <div class="text-cobol-cyan">PROCEDURE DIVISION.</div>
                    <div class="text-terminal-text"><span class="syntax-keyword">DISPLAY</span> WS-MESSAGE.</div>
                    <div class="text-terminal-text"><span class="syntax-keyword">STOP RUN</span>.</div>
                </div>
            </div>
        </div>

        <div class="floating-code absolute bottom-16 right-8 opacity-25 animate-float hidden lg:block" style="animation-delay: 1s;">
            <div class="terminal-window w-72">
                <div class="terminal-header">
                    <span class="terminal-dot dot-red"></span>
                    <span class="terminal-dot dot-yellow"></span>
                    <span class="terminal-dot dot-green"></span>
                    <span class="text-white/60 text-xs ml-4 font-mono">DATA-PROC.cbl</span>
                </div>
                <div class="p-4 font-mono text-xs space-y-1">
                    <div class="text-cobol-green">WORKING-STORAGE SECTION.</div>
                    <div class="text-terminal-text">01 <span class="text-cobol-amber">EMPLOYEE-RECORD</span>.</div>
                    <div class="text-terminal-text">   05 <span class="text-cobol-amber">EMP-ID</span>     <span class="syntax-keyword">PIC</span> <span class="text-cobol-amber">9(6)</span>.</div>
                    <div class="text-terminal-text">   05 <span class="text-cobol-amber">EMP-NAME</span>   <span class="syntax-keyword">PIC</span> <span class="text-cobol-amber">X(25)</span>.</div>
                    <div class="text-terminal-text">   05 <span class="text-cobol-amber">EMP-SALARY</span> <span class="syntax-keyword">PIC</span> <span class="text-cobol-amber">9(8)V99</span>.</div>
                    <div></div>
                    <div class="text-cobol-cyan">PROCEDURE DIVISION.</div>
                    <div class="text-terminal-text"><span class="syntax-keyword">READ</span> EMPLOYEE-FILE</div>
                    <div class="text-terminal-text">   <span class="syntax-keyword">INTO</span> EMPLOYEE-RECORD</div>
                    <div class="text-terminal-text"><span class="syntax-keyword">IF</span> EMP-SALARY > 50000</div>
                    <div class="text-terminal-text">   <span class="syntax-keyword">DISPLAY</span> <span class="syntax-string">'Senior Employee'</span></div>
                    <div class="text-terminal-text"><span class="syntax-keyword">END-IF</span>.</div>
                </div>
            </div>
        </div>

        <!-- Additional floating element for larger screens -->
        <div class="floating-code absolute top-1/2 left-4 opacity-20 animate-float hidden xl:block" style="animation-delay: 2s;">
            <div class="terminal-window w-64">
                <div class="terminal-header">
                    <span class="terminal-dot dot-red"></span>
                    <span class="terminal-dot dot-yellow"></span>
                    <span class="terminal-dot dot-green"></span>
                    <span class="text-white/60 text-xs ml-4 font-mono">MODERN.cbl</span>
                </div>
                <div class="p-3 font-mono text-xs space-y-1">
                    <div class="syntax-comment">* Modern COBOL Features</div>
                    <div class="text-cobol-cyan">01 <span class="text-cobol-amber">JSON-DATA</span>.</div>
                    <div class="text-terminal-text">   05 <span class="text-cobol-amber">CUSTOMER-ID</span> <span class="syntax-keyword">PIC</span> <span class="text-cobol-amber">9(8)</span>.</div>
                    <div class="text-terminal-text">   05 <span class="text-cobol-amber">ORDER-DATE</span>  <span class="syntax-keyword">PIC</span> <span class="text-cobol-amber">X(10)</span>.</div>
                    <div></div>
                    <div class="text-terminal-text"><span class="syntax-keyword">CALL</span> <span class="syntax-string">'JSON-PARSE'</span></div>
                    <div class="text-terminal-text">   <span class="syntax-keyword">USING</span> JSON-STRING</div>
                    <div class="text-terminal-text">   <span class="syntax-keyword">GIVING</span> JSON-DATA.</div>
                </div>
            </div>
        </div>

        <div class="container mx-auto px-4 text-center relative z-10">
            <div class="max-w-4xl mx-auto">
                <!-- Main heading with typing animation -->
                <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 animate-fade-in mt-6">
                    <span class="font-mono text-white">Čo bol</span><span class="text-cobol-amber font-mono"> COBOL?</span>
                </h1>

                <!-- Subtitle -->
                <p class="text-xl md:text-2xl text-white/90 mb-8 animate-slide-up">
                    Master Modern COBOL Development with
                    <span class="text-cobol-cyan font-semibold">Premium Content</span> &
                    <span class="text-cobol-amber font-semibold">Expert Tutorials</span>
                </p>

                <!-- Feature highlights -->
                <div class="flex flex-wrap justify-center gap-4 mb-10 animate-slide-up" style="animation-delay: 0.3s;">
                    <span class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full text-white/80 text-sm border border-white/20">
                        <i class="fas fa-code mr-2 text-cobol-cyan"></i>Modern COBOL Syntax
                    </span>
                    <span class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full text-white/80 text-sm border border-white/20">
                        <i class="fas fa-database mr-2 text-cobol-green"></i>Enterprise Integration
                    </span>
                    <span class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full text-white/80 text-sm border border-white/20">
                        <i class="fas fa-rocket mr-2 text-cobol-amber"></i>Performance Optimization
                    </span>
                </div>

                <!-- Action buttons -->
                {% if not app.user %}
                    <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up" style="animation-delay: 0.6s;">
                        <a href="{{ path('app_register') }}" class="bg-white text-cobol-navy px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/90 transition-all duration-200 transform hover:scale-105 shadow-xl hover:shadow-2xl">
                            <i class="fas fa-rocket mr-2"></i>Start Learning Free
                        </a>
                        <a href="{{ path('app_pricing') }}" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white hover:text-cobol-navy transition-all duration-200 transform hover:scale-105">
                            <i class="fas fa-eye mr-2"></i>View Pricing
                        </a>
                    </div>
                {% else %}
                    <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up" style="animation-delay: 0.6s;">
                        <a href="{{ path('app_dashboard') }}" class="bg-white text-cobol-navy px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white/90 transition-all duration-200 transform hover:scale-105 shadow-xl">
                            <i class="fas fa-tachometer-alt mr-2"></i>Go to Dashboard
                        </a>
                        {% if not is_granted('ROLE_SUBSCRIBER') %}
                            <a href="{{ path('app_pricing') }}" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-white hover:text-cobol-navy transition-all duration-200 transform hover:scale-105">
                                <i class="fas fa-crown mr-2"></i>Upgrade to Premium
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                <!-- Stats -->
                <div class="hero-stats grid grid-cols-1 sm:grid-cols-3 gap-8 mt-16 animate-fade-in" style="animation-delay: 0.9s;">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-white font-mono">1000+</div>
                        <div class="text-white/70 text-sm">Active Developers</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-white font-mono">50+</div>
                        <div class="text-white/70 text-sm">Premium Tutorials</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-white font-mono">24/7</div>
                        <div class="text-white/70 text-sm">Expert Support</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
            <i class="fas fa-chevron-down text-white/50 text-xl"></i>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold text-gray-900 mb-4">
                    Why Choose <span class="text-gradient font-mono">COBOLCOBOL</span>?
                </h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                    Comprehensive platform designed for modern COBOL developers and enterprise teams
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="group bg-white rounded-xl p-8 shadow-lg hover-lift border border-gray-200">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-cyan to-cobol-blue rounded-lg flex items-center justify-center mb-6 group-hover:animate-pulse">
                        <i class="fas fa-code text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Modern COBOL Syntax</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Learn the latest COBOL standards with comprehensive tutorials covering object-oriented programming, JSON handling, and modern development practices.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="group bg-white rounded-xl p-8 shadow-lg hover-lift border border-gray-200">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-green to-cobol-cyan rounded-lg flex items-center justify-center mb-6 group-hover:animate-pulse">
                        <i class="fas fa-database text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Enterprise Integration</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Master enterprise-grade COBOL development with tutorials on DB2, IMS, CICS, and modern web service integration patterns.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="group bg-white rounded-xl p-8 shadow-lg hover-lift border border-gray-200">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-amber to-cobol-green rounded-lg flex items-center justify-center mb-6 group-hover:animate-pulse">
                        <i class="fas fa-rocket text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Performance Optimization</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Discover advanced techniques for optimizing COBOL applications, memory management, and best practices for mainframe environments.
                    </p>
                </div>

                <!-- Feature 4 -->
                <div class="group bg-white rounded-xl p-8 shadow-lg hover-lift border border-gray-200">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-blue to-cobol-amber rounded-lg flex items-center justify-center mb-6 group-hover:animate-pulse">
                        <i class="fas fa-shield-alt text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Security Best Practices</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Learn enterprise security patterns, data protection, and secure coding practices for mission-critical COBOL applications.
                    </p>
                </div>

                <!-- Feature 5 -->
                <div class="group bg-white rounded-xl p-8 shadow-lg hover-lift border border-gray-200">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-red to-cobol-blue rounded-lg flex items-center justify-center mb-6 group-hover:animate-pulse">
                        <i class="fas fa-users text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">Expert Community</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Connect with seasoned COBOL professionals, share knowledge, and get answers from industry experts with decades of experience.
                    </p>
                </div>

                <!-- Feature 6 -->
                <div class="group bg-white rounded-xl p-8 shadow-lg hover-lift border border-gray-200">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-green to-cobol-red rounded-lg flex items-center justify-center mb-6 group-hover:animate-pulse">
                        <i class="fas fa-clock text-white text-2xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-4">24/7 Access</h3>
                    <p class="text-gray-600 leading-relaxed">
                        Access your learning materials anytime, anywhere. Download resources for offline study and never miss a beat in your development journey.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Articles Section -->
    {% if recent_articles %}
    <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold text-gray-900 mb-4">Latest COBOL Insights</h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                    Stay updated with the latest COBOL developments, best practices, and industry insights
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {% for article in recent_articles %}
                <article class="group bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden hover-lift transition-all duration-300 {% if article.isPremium %}border-gradient{% endif %}">
                    <!-- Article Header -->
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex-1">
                                {% if article.isPremium %}
                                    <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-cobol-amber to-cobol-green text-white mb-3">
                                        <i class="fas fa-crown mr-1"></i>Premium
                                    </div>
                                {% endif %}
                                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-cobol-blue transition-colors line-clamp-2">
                                    {{ article.title }}
                                </h3>
                            </div>
                        </div>

                        <p class="text-gray-600 mb-6 line-clamp-3">{{ article.preview(120) }}</p>

                        <!-- Article Meta -->
                        <div class="flex items-center justify-between text-sm text-gray-500 mb-6">
                            <div class="flex items-center">
                                <i class="fas fa-clock mr-2 text-cobol-cyan"></i>
                                {{ article.readingTime }} min read
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-calendar mr-2 text-cobol-cyan"></i>
                                {{ article.publishedAt ? article.publishedAt.format('M d, Y') : 'Draft' }}
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div class="flex items-center">
                            {% if article.isPremium and not is_granted('ROLE_SUBSCRIBER') %}
                                <a href="{{ path('app_pricing') }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-lg font-medium hover:from-cobol-green hover:to-cobol-amber transition-all duration-200 group">
                                    <i class="fas fa-lock mr-2"></i>
                                    Upgrade to Read
                                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                                </a>
                            {% else %}
                                <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white rounded-lg font-medium hover:from-cobol-blue hover:to-cobol-cyan transition-all duration-200 group">
                                    Read Article
                                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </article>
                {% endfor %}
            </div>

            <div class="text-center mt-12">
                <a href="{{ path('app_articles') }}" class="inline-flex items-center px-8 py-3 border-2 border-cobol-cyan text-cobol-cyan rounded-lg font-semibold hover:bg-cobol-cyan hover:text-white transition-all duration-200 group">
                    <i class="fas fa-newspaper mr-2"></i>
                    View All Articles
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Pricing Preview -->
    {% if plans %}
    <section class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold text-gray-900 mb-4">Simple, Transparent Pricing</h2>
                <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                    Choose the perfect plan for your COBOL learning journey
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                {% for plan in plans|slice(0, 2) %}
                <div class="relative bg-white rounded-2xl shadow-xl border border-gray-200 hover-lift transition-all duration-300 {% if loop.last %}border-gradient transform scale-105{% endif %}">
                    {% if loop.last %}
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
                            <span class="bg-gradient-to-r from-cobol-amber to-cobol-green text-white px-6 py-2 rounded-full text-sm font-semibold">
                                Most Popular
                            </span>
                        </div>
                    {% endif %}

                    <div class="p-8 text-center">
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">{{ plan.name }}</h3>
                        <p class="text-gray-600 mb-8">{{ plan.description }}</p>

                        <!-- Price -->
                        <div class="mb-8">
                            <span class="text-5xl font-bold text-gray-900">{{ plan.formattedPriceMonthly }}</span>
                            <span class="text-gray-600 ml-2">/month</span>
                        </div>

                        <!-- Features placeholder -->
                        <div class="space-y-4 mb-8">
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check text-cobol-green mr-3"></i>
                                <span>Access to premium COBOL tutorials</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check text-cobol-green mr-3"></i>
                                <span>Enterprise integration examples</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check text-cobol-green mr-3"></i>
                                <span>{% if loop.last %}Priority{% else %}Community{% endif %} support</span>
                            </div>
                            {% if loop.last %}
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check text-cobol-green mr-3"></i>
                                <span>Advanced optimization techniques</span>
                            </div>
                            <div class="flex items-center text-gray-700">
                                <i class="fas fa-check text-cobol-green mr-3"></i>
                                <span>Exclusive expert Q&A sessions</span>
                            </div>
                            {% endif %}
                        </div>

                        <!-- Action Button -->
                        {% if not app.user %}
                            <a href="{{ path('app_register') }}" class="w-full inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-lg transition-all duration-200 transform hover:scale-105 {% if loop.last %}bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white hover:from-cobol-blue hover:to-cobol-cyan shadow-xl{% else %}border-2 border-cobol-cyan text-cobol-cyan hover:bg-cobol-cyan hover:text-white{% endif %}">
                                Get Started
                            </a>
                        {% elseif not is_granted('ROLE_SUBSCRIBER') %}
                            <a href="{{ path('app_subscribe', {id: plan.id}) }}" class="w-full inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-lg transition-all duration-200 transform hover:scale-105 {% if loop.last %}bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white hover:from-cobol-blue hover:to-cobol-cyan shadow-xl{% else %}border-2 border-cobol-cyan text-cobol-cyan hover:bg-cobol-cyan hover:text-white{% endif %}">
                                Subscribe Now
                            </a>
                        {% else %}
                            <button class="w-full px-6 py-3 bg-cobol-green text-white rounded-lg font-semibold text-lg" disabled>
                                <i class="fas fa-check-circle mr-2"></i>Current Plan
                            </button>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>

            <div class="text-center mt-12">
                <a href="{{ path('app_pricing') }}" class="inline-flex items-center px-8 py-3 border-2 border-gray-400 text-gray-700 rounded-lg font-semibold hover:border-cobol-cyan hover:text-cobol-cyan transition-all duration-200 group">
                    <i class="fas fa-list mr-2"></i>
                    View All Plans
                    <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Code Sample Section -->
    <section class="py-20 bg-cobol-navy">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold text-white mb-4">
                    Experience Modern <span class="font-mono text-cobol-cyan">COBOL</span>
                </h2>
                <p class="text-xl text-white/80 max-w-3xl mx-auto">
                    See how our platform teaches you to write clean, efficient, and maintainable COBOL code
                </p>
            </div>

            <div class="max-w-4xl mx-auto">
                <div class="terminal-window">
                    <div class="terminal-header">
                        <span class="terminal-dot dot-red"></span>
                        <span class="terminal-dot dot-yellow"></span>
                        <span class="terminal-dot dot-green"></span>
                        <span class="text-white/60 text-sm ml-4 font-mono">COBOL-EXAMPLE.cbl</span>
                    </div>
                    <div class="p-6 font-mono text-sm overflow-x-auto">
                        <div class="space-y-1">
                            <div><span class="syntax-comment">      * Modern COBOL with JSON Integration</span></div>
                            <div><span class="syntax-keyword">       IDENTIFICATION DIVISION.</span></div>
                            <div><span class="text-terminal-text">       PROGRAM-ID. </span><span class="syntax-string">JSON-PROCESSOR</span><span class="text-terminal-text">.</span></div>
                            <div></div>
                            <div><span class="syntax-keyword">       DATA DIVISION.</span></div>
                            <div><span class="syntax-keyword">       WORKING-STORAGE SECTION.</span></div>
