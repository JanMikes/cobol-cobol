{% extends 'base.html.twig' %}

{% block title %}Articles - COBOLCOBOL{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-journal-text"></i> Articles</h1>
                {% if not has_subscription %}
                <a href="{{ path('app_pricing') }}" class="btn btn-primary">
                    <i class="bi bi-star"></i> Upgrade for Premium Content
                </a>
                {% endif %}
            </div>

            {% if articles|length > 0 %}
                <div class="row">
                    {% for article in articles %}
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 {% if article.premium %}card-premium{% endif %}">
                            {% if article.featuredImage %}
                            <img src="{{ article.featuredImage }}" class="card-img-top" alt="{{ article.title }}" style="height: 200px; object-fit: cover;">
                            {% else %}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                            {% endif %}

                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title">{{ article.title }}</h5>
                                    {% if article.premium %}
                                    <span class="premium-badge">
                                        <i class="bi bi-star-fill"></i> Premium
                                    </span>
                                    {% endif %}
                                </div>

                                <p class="card-text text-muted small">
                                    <i class="bi bi-calendar"></i> {{ article.publishedAt|date('M j, Y') }}
                                    {% if article.author %}
                                    <span class="ms-2">
                                        <i class="bi bi-person"></i> {{ article.author.firstName }} {{ article.author.lastName }}
                                    </span>
                                    {% endif %}
                                </p>

                                <p class="card-text">{{ article.excerpt }}</p>

                                <div class="mt-auto">
                                    {% if article.premium and not has_subscription %}
                                    <div class="text-center">
                                        <p class="text-muted mb-2">
                                            <i class="bi bi-lock"></i> Premium content requires subscription
                                        </p>
                                        <a href="{{ path('app_pricing') }}" class="btn btn-sm btn-outline-primary">
                                            Subscribe to Read
                                        </a>
                                    </div>
                                    {% else %}
                                    <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="btn btn-primary">
                                        Read More <i class="bi bi-arrow-right"></i>
                                    </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>

                <!-- Pagination would go here -->
                <nav aria-label="Articles pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled">
                            <span class="page-link">Previous</span>
                        </li>
                        <li class="page-item active">
                            <span class="page-link">1</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Next</span>
                        </li>
                    </ul>
                </nav>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-journal-x text-muted" style="font-size: 4rem;"></i>
                    <h3 class="mt-3">No articles available</h3>
                    <p class="text-muted">Check back later for new content!</p>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <!-- Content Filter -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-funnel"></i> Filter Content</h5>
                </div>
                <div class="card-body">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showFree" checked>
                        <label class="form-check-label" for="showFree">
                            Free Articles
                        </label>
                    </div>
                    {% if has_subscription %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showPremium" checked>
                        <label class="form-check-label" for="showPremium">
                            <i class="bi bi-star-fill text-warning"></i> Premium Articles
                        </label>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Subscription Status -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Your Access</h5>
                </div>
                <div class="card-body">
                    {% if has_subscription %}
                    <div class="text-center">
                        <div class="premium-badge d-inline-block mb-3">
                            <i class="bi bi-star-fill"></i> Premium Member
                        </div>
                        <p class="mb-0">You have access to all premium content!</p>
                        <a href="{{ path('app_premium') }}" class="btn btn-sm btn-outline-warning mt-2">
                            <i class="bi bi-star"></i> View Premium Articles
                        </a>
                    </div>
                    {% else %}
                    <div class="text-center">
                        <i class="bi bi-lock text-muted mb-3" style="font-size: 2rem;"></i>
                        <p class="mb-3">Upgrade to premium to unlock exclusive content</p>
                        <a href="{{ path('app_pricing') }}" class="btn btn-primary btn-sm">
                            <i class="bi bi-arrow-up"></i> Upgrade Now
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Categories -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-tags"></i> Categories</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action">
                            Technology <span class="badge bg-secondary rounded-pill">5</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            Business <span class="badge bg-secondary rounded-pill">3</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            Development <span class="badge bg-secondary rounded-pill">7</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            Design <span class="badge bg-secondary rounded-pill">2</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}