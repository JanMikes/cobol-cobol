{% extends 'base.html.twig' %}

{% block title %}Články - Čo bol COBOL?{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="bg-gradient-to-r from-cobol-navy to-cobol-blue py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
            <div>
                <h1 class="text-4xl font-bold text-white flex items-center mb-4">
                    <i class="fas fa-newspaper mr-4 text-cobol-cyan"></i>
                    COBOL Články & Tutoriály
                </h1>
                <p class="text-white/80 text-lg max-w-2xl">
                    Objavte moderné COBOL programovanie s našimi expertne napísanými článkami a praktickými tutoriálmi.
                </p>
            </div>
            {% if not has_subscription %}
            <div class="mt-6 md:mt-0">
                <a href="{{ path('app_pricing') }}" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-lg font-semibold hover:from-cobol-green hover:to-cobol-amber transition-all duration-200 transform hover:scale-105 shadow-lg">
                    <i class="fas fa-crown mr-2"></i>
                    Získať Premium Prístup
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-3">

            {% if articles|length > 0 %}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                    {% for article in articles %}
                    <article class="group bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden hover-lift transition-all duration-300 {% if article.premium %}border-gradient{% endif %}">
                        <!-- Article Image -->
                        {% if article.featuredImage %}
                        <div class="h-48 overflow-hidden">
                            <img src="{{ article.featuredImage }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="{{ article.title }}">
                        </div>
                        {% else %}
                        <div class="h-48 bg-gradient-to-br from-cobol-navy to-cobol-blue flex items-center justify-center">
                            <i class="fas fa-code text-white text-4xl opacity-50"></i>
                        </div>
                        {% endif %}

                        <!-- Article Content -->
                        <div class="p-6">
                            <!-- Header with title and premium badge -->
                            <div class="flex justify-between items-start mb-4">
                                <h2 class="text-xl font-semibold text-gray-900 group-hover:text-cobol-blue transition-colors line-clamp-2 flex-1 mr-3">
                                    {{ article.title }}
                                </h2>
                                {% if article.premium %}
                                <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-cobol-amber to-cobol-green text-white flex-shrink-0">
                                    <i class="fas fa-crown mr-1"></i>Premium
                                </div>
                                {% endif %}
                            </div>

                            <!-- Article Meta -->
                            <div class="flex items-center text-sm text-gray-500 mb-4">
                                <i class="fas fa-calendar mr-2 text-cobol-cyan"></i>
                                {{ article.publishedAt|date('M j, Y') }}
                                {% if article.author %}
                                <span class="mx-2">•</span>
                                <i class="fas fa-user mr-2 text-cobol-cyan"></i>
                                {{ article.author.firstName }} {{ article.author.lastName }}
                                {% endif %}
                            </div>

                            <!-- Excerpt -->
                            <p class="text-gray-600 mb-6 line-clamp-3">{{ article.excerpt }}</p>

                            <!-- Action Button -->
                            <div class="flex items-center">
                                {% if article.premium and not has_subscription %}
                                    <div class="text-center w-full">
                                        <p class="text-gray-500 text-sm mb-3 flex items-center justify-center">
                                            <i class="fas fa-lock mr-2 text-cobol-amber"></i>
                                            Prémiový obsah vyžaduje predplatné
                                        </p>
                                        <a href="{{ path('app_pricing') }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-lg font-medium hover:from-cobol-green hover:to-cobol-amber transition-all duration-200 group">
                                            <i class="fas fa-unlock mr-2"></i>
                                            Predplatiť & Čítať
                                            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                                        </a>
                                    </div>
                                {% else %}
                                    <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white rounded-lg font-medium hover:from-cobol-blue hover:to-cobol-cyan transition-all duration-200 group">
                                        Čítať článok
                                        <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                <div class="flex justify-center items-center space-x-2 mb-8">
                    <button class="px-4 py-2 border border-gray-300 text-gray-500 rounded-lg cursor-not-allowed" disabled>
                        <i class="fas fa-chevron-left mr-2"></i>Predchádzajúce
                    </button>
                    <span class="px-4 py-2 bg-cobol-cyan text-white rounded-lg font-semibold">1</span>
                    <button class="px-4 py-2 border border-gray-300 text-gray-500 rounded-lg cursor-not-allowed" disabled>
                        Nasledujúce<i class="fas fa-chevron-right ml-2"></i>
                    </button>
                </div>
            {% else %}
                <div class="text-center py-16 bg-white rounded-xl shadow-lg">
                    <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-newspaper text-gray-400 text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-semibold text-gray-900 mb-4">Žiadne články zatiaľ</h3>
                    <p class="text-gray-600 mb-6">Skontrolujte neskôr nový obsah!</p>
                    <a href="{{ path('app_home') }}" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white rounded-lg font-semibold hover:from-cobol-blue hover:to-cobol-cyan transition-all duration-200">
                        <i class="fas fa-home mr-2"></i>Späť na úvod
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Content Filter -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-filter mr-3 text-cobol-cyan"></i>
                        Filter obsahu
                    </h3>
                </div>
                <div class="p-6 space-y-4">
                    <label class="flex items-center">
                        <input type="checkbox" id="showFree" checked class="w-4 h-4 text-cobol-cyan border-gray-300 rounded focus:ring-cobol-cyan">
                        <span class="ml-3 text-gray-700">Bezplatné články</span>
                    </label>
                    {% if has_subscription %}
                    <label class="flex items-center">
                        <input type="checkbox" id="showPremium" checked class="w-4 h-4 text-cobol-amber border-gray-300 rounded focus:ring-cobol-amber">
                        <span class="ml-3 text-gray-700 flex items-center">
                            <i class="fas fa-crown text-cobol-amber mr-2"></i>
                            Prémiové články
                        </span>
                    </label>
                    {% endif %}
                </div>
            </div>

            <!-- Subscription Status -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-info-circle mr-3 text-cobol-blue"></i>
                        Váš prístup
                    </h3>
                </div>
                <div class="p-6">
                    {% if has_subscription %}
                    <div class="text-center space-y-4">
                        <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-full font-semibold">
                            <i class="fas fa-crown mr-2"></i>
                            Premium člen
                        </div>
                        <p class="text-gray-600">Máte prístup ku všetkému prémiovému obsahu!</p>
                        <a href="{{ path('app_premium') }}" class="inline-flex items-center px-4 py-2 border-2 border-cobol-amber text-cobol-amber rounded-lg font-medium hover:bg-cobol-amber hover:text-white transition-all duration-200">
                            <i class="fas fa-star mr-2"></i>
                            Zobraziť Premium články
                        </a>
                    </div>
                    {% else %}
                    <div class="text-center space-y-4">
                        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto">
                            <i class="fas fa-lock text-gray-400 text-2xl"></i>
                        </div>
                        <div>
                            <h4 class="text-lg font-semibold text-gray-900 mb-2">Odomknúť Premium</h4>
                            <p class="text-gray-600 text-sm">Upgradujte na premium pre prístup k exkluzívnemu obsahu</p>
                        </div>
                        <a href="{{ path('app_pricing') }}" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-green to-cobol-cyan text-white rounded-lg font-medium hover:from-cobol-cyan hover:to-cobol-green transition-all duration-200">
                            <i class="fas fa-arrow-up mr-2"></i>
                            Upgradovať teraz
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Categories -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-tags mr-3 text-cobol-green"></i>
                        Kategórie
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-3">
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-cyan transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-laptop-code mr-3 text-cobol-cyan group-hover:text-cobol-blue"></i>
                                COBOL Základy
                            </span>
                            <span class="bg-gray-200 text-gray-700 px-2 py-1 rounded-full text-xs font-medium">8</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-cyan transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-building mr-3 text-cobol-cyan group-hover:text-cobol-blue"></i>
                                Enterprise COBOL
                            </span>
                            <span class="bg-gray-200 text-gray-700 px-2 py-1 rounded-full text-xs font-medium">12</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-cyan transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-database mr-3 text-cobol-cyan group-hover:text-cobol-blue"></i>
                                DB2 Integrácia
                            </span>
                            <span class="bg-gray-200 text-gray-700 px-2 py-1 rounded-full text-xs font-medium">6</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-cyan transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-rocket mr-3 text-cobol-cyan group-hover:text-cobol-blue"></i>
                                Moderné techniky
                            </span>
                            <span class="bg-gray-200 text-gray-700 px-2 py-1 rounded-full text-xs font-medium">4</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}