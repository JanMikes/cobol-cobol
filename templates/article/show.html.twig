{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} - Čo bol COBOL?{% endblock %}
{% block meta_description %}{{ article.excerpt }}{% endblock %}

{% block body %}
<!-- Article Header -->
<div class="bg-gradient-to-r from-cobol-navy to-cobol-blue py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex mb-8" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="{{ path('app_articles') }}" class="inline-flex items-center text-sm font-medium text-white/70 hover:text-white transition-colors">
                        <i class="fas fa-newspaper mr-2"></i>
                        Články
                    </a>
                </li>
                <li>
                    <div class="flex items-center">
                        <i class="fas fa-chevron-right text-white/50 mx-3"></i>
                        <span class="ml-1 text-sm font-medium text-white/90 md:ml-2">{{ article.title }}</span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="flex flex-col lg:flex-row justify-between items-start">
            <div class="flex-1">
                <!-- Premium Badge -->
                {% if article.premium %}
                <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-full font-semibold text-sm mb-6">
                    <i class="fas fa-crown mr-2"></i>
                    Prémiový článok
                </div>
                {% endif %}

                <!-- Title -->
                <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
                    {{ article.title }}
                </h1>

                <!-- Article Meta -->
                <div class="flex flex-wrap items-center gap-6 text-white/80 mb-6">
                    {% if article.author %}
                    <div class="flex items-center">
                        <i class="fas fa-user mr-2 text-cobol-cyan"></i>
                        {{ article.author.firstName }} {{ article.author.lastName }}
                    </div>
                    {% endif %}
                    <div class="flex items-center">
                        <i class="fas fa-calendar mr-2 text-cobol-cyan"></i>
                        {{ article.publishedAt|date('F j, Y') }}
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-clock mr-2 text-cobol-cyan"></i>
                        {{ article.readingTime ?? '5' }} min čítania
                    </div>
                </div>

                <!-- Tags -->
                {% if article.tags %}
                <div class="flex flex-wrap gap-2">
                    {% for tag in article.tags %}
                    <span class="px-3 py-1 bg-white/10 backdrop-blur-sm text-white rounded-full text-sm">
                        {{ tag }}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-3">
            <article class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <!-- Featured Image -->
                {% if article.featuredImage %}
                <div class="h-64 md:h-80 overflow-hidden">
                    <img src="{{ article.featuredImage }}" class="w-full h-full object-cover" alt="{{ article.title }}">
                </div>
                {% endif %}

                <div class="p-8">
                    <!-- Excerpt -->
                    {% if article.excerpt %}
                    <div class="text-xl text-gray-700 leading-relaxed mb-8 p-6 bg-gray-50 border-l-4 border-cobol-cyan rounded-r-lg">
                        {{ article.excerpt }}
                    </div>
                    {% endif %}

                    <!-- Article Content -->
                    <div class="article-content prose prose-lg max-w-none">
                        {{ article.content|raw }}
                    </div>

                    <!-- Article Footer -->
                    <footer class="mt-12 pt-8 border-t border-gray-200">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                            <div class="mb-6 md:mb-0">
                                <h6 class="text-lg font-semibold text-gray-900 mb-4">Zdieľať článok</h6>
                                <div class="flex space-x-3">
                                    <a href="#" class="inline-flex items-center px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors">
                                        <i class="fab fa-twitter mr-2"></i>Twitter
                                    </a>
                                    <a href="#" class="inline-flex items-center px-4 py-2 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-colors">
                                        <i class="fab fa-facebook mr-2"></i>Facebook
                                    </a>
                                    <a href="#" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                        <i class="fab fa-linkedin mr-2"></i>LinkedIn
                                    </a>
                                </div>
                            </div>
                            <div class="text-right">
                                {% if article.updatedAt and article.updatedAt != article.publishedAt %}
                                <p class="text-sm text-gray-500">
                                    Posledná aktualizácia: {{ article.updatedAt|date('F j, Y') }}
                                </p>
                                {% endif %}
                            </div>
                        </div>
                    </footer>
                </div>
            </article>

            <!-- Related Articles -->
            <section class="mt-12">
                <h3 class="text-2xl font-bold text-gray-900 mb-8">Súvisiace články</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <article class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden hover-lift">
                        <div class="h-40 bg-gradient-to-br from-cobol-navy to-cobol-blue flex items-center justify-center">
                            <i class="fas fa-code text-white text-2xl opacity-50"></i>
                        </div>
                        <div class="p-6">
                            <h4 class="font-semibold text-gray-900 mb-3">COBOL Základy pre začiatočníkov</h4>
                            <p class="text-gray-600 text-sm mb-4">Zoznámte sa so základmi COBOL programovania a naučte sa prvé kroky...</p>
                            <a href="#" class="inline-flex items-center text-cobol-cyan hover:text-cobol-blue font-medium">
                                Čítať viac
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </article>

                    <article class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden hover-lift">
                        <div class="h-40 bg-gradient-to-br from-cobol-green to-cobol-cyan flex items-center justify-center">
                            <i class="fas fa-database text-white text-2xl opacity-50"></i>
                        </div>
                        <div class="p-6">
                            <h4 class="font-semibold text-gray-900 mb-3">Enterprise COBOL a DB2</h4>
                            <p class="text-gray-600 text-sm mb-4">Naučte sa pracovať s databázami v Enterprise prostredí pomocou COBOL...</p>
                            <a href="#" class="inline-flex items-center text-cobol-cyan hover:text-cobol-blue font-medium">
                                Čítať viac
                                <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </article>
                </div>
            </section>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Table of Contents -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden sticky top-20">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-list mr-3 text-cobol-cyan"></i>
                        Obsah článku
                    </h3>
                </div>
                <div class="p-6">
                    <nav class="toc space-y-2">
                        <a href="#introduction" class="block text-gray-600 hover:text-cobol-cyan transition-colors py-1 border-l-2 border-transparent hover:border-cobol-cyan pl-3">
                            Úvod do COBOL
                        </a>
                        <a href="#main-content" class="block text-gray-600 hover:text-cobol-cyan transition-colors py-1 border-l-2 border-transparent hover:border-cobol-cyan pl-3">
                            Hlavný obsah
                        </a>
                        <a href="#examples" class="block text-gray-600 hover:text-cobol-cyan transition-colors py-1 border-l-2 border-transparent hover:border-cobol-cyan pl-3">
                            Praktické príklady
                        </a>
                        <a href="#conclusion" class="block text-gray-600 hover:text-cobol-cyan transition-colors py-1 border-l-2 border-transparent hover:border-cobol-cyan pl-3">
                            Záver
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Author Info -->
            {% if article.author %}
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-user-circle mr-3 text-cobol-blue"></i>
                        O autorovi
                    </h3>
                </div>
                <div class="p-6">
                    <div class="flex items-center mb-4">
                        <div class="w-12 h-12 bg-gradient-to-r from-cobol-cyan to-cobol-blue rounded-full flex items-center justify-center mr-4">
                            <i class="fas fa-user text-white"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-gray-900">{{ article.author.firstName }} {{ article.author.lastName }}</h4>
                            <p class="text-gray-600 text-sm">COBOL Expert</p>
                        </div>
                    </div>
                    <p class="text-gray-600 text-sm">
                        Skúsený vývojár s viacročnými skúsenosťami v Enterprise COBOL programovaní a modernizácii legacy systémov.
                    </p>
                </div>
            </div>
            {% endif %}

            <!-- Newsletter Signup -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-envelope mr-3 text-cobol-green"></i>
                        Novinky
                    </h3>
                </div>
                <div class="p-6">
                    <p class="text-gray-600 text-sm mb-4">
                        Získajte najnovšie články priamo do svojej schránky.
                    </p>
                    <form class="space-y-4">
                        <input type="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cobol-cyan focus:border-transparent" placeholder="Váš email">
                        <button type="submit" class="w-full bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white py-2 rounded-lg font-medium hover:from-cobol-blue hover:to-cobol-cyan transition-all duration-200">
                            Odberať novinky
                        </button>
                    </form>
                </div>
            </div>

            <!-- Popular Articles -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-fire mr-3 text-cobol-red"></i>
                        Populárne články
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <a href="#" class="block group">
                            <h4 class="font-medium text-gray-900 group-hover:text-cobol-cyan transition-colors text-sm mb-1">
                                Začíname s COBOL programovaním
                            </h4>
                            <p class="text-gray-500 text-xs">1,234 zobrazení</p>
                        </a>
                        <a href="#" class="block group">
                            <h4 class="font-medium text-gray-900 group-hover:text-cobol-cyan transition-colors text-sm mb-1">
                                Moderné techniky v COBOL
                            </h4>
                            <p class="text-gray-500 text-xs">987 zobrazení</p>
                        </a>
                        <a href="#" class="block group">
                            <h4 class="font-medium text-gray-900 group-hover:text-cobol-cyan transition-colors text-sm mb-1">
                                COBOL a databázy DB2
                            </h4>
                            <p class="text-gray-500 text-xs">756 zobrazení</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Enhanced article content styling */
.article-content {
    line-height: 1.8;
    font-size: 1.125rem;
    color: #374151;
}

.article-content h1,
.article-content h2,
.article-content h3,
.article-content h4,
.article-content h5,
.article-content h6 {
    color: #111827;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
}

.article-content h2 {
    font-size: 1.875rem;
    border-bottom: 2px solid #06b6d4;
    padding-bottom: 0.5rem;
}

.article-content h3 {
    font-size: 1.5rem;
}

.article-content p {
    margin-bottom: 1.5rem;
}

.article-content blockquote {
    border-left: 4px solid #06b6d4;
    background: #f0f9ff;
    padding: 1.5rem;
    margin: 2rem 0;
    border-radius: 0 8px 8px 0;
    font-style: italic;
}

.article-content code {
    background: #0d1117;
    color: #c9d1d9;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
}

.article-content pre {
    background: #0d1117;
    color: #c9d1d9;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid #30363d;
    font-family: 'JetBrains Mono', monospace;
}

.article-content pre code {
    background: transparent;
    padding: 0;
}

.article-content ul,
.article-content ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
}

.article-content li {
    margin-bottom: 0.5rem;
}

.article-content a {
    color: #06b6d4;
    text-decoration: underline;
    transition: color 0.2s;
}

.article-content a:hover {
    color: #0891b2;
}
</style>
{% endblock %}