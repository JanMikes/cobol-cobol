{% extends 'base.html.twig' %}

{% block title %}Premium Content - COBOLCOBOL{% endblock %}

{% block body %}
<div class="container mt-4">
    <!-- Premium Header -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card bg-gradient text-white" style="background: linear-gradient(45deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-center py-5">
                    <h1 class="display-4 fw-bold">
                        <i class="bi bi-star-fill"></i> Premium Content
                    </h1>
                    <p class="lead mb-0">Exclusive articles and in-depth content for our premium subscribers</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            {% if articles|length > 0 %}
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Latest Premium Articles</h2>
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-lock-fill"></i> {{ articles|length }} Exclusive Articles
                    </span>
                </div>

                <!-- Premium Articles Grid -->
                <div class="row">
                    {% for article in articles %}
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100 card-premium">
                            {% if article.featuredImage %}
                            <div class="position-relative">
                                <img src="{{ article.featuredImage }}" class="card-img-top" alt="{{ article.title }}" style="height: 200px; object-fit: cover;">
                                <span class="position-absolute top-0 end-0 m-2 premium-badge">
                                    <i class="bi bi-star-fill"></i> Premium
                                </span>
                            </div>
                            {% else %}
                            <div class="card-img-top bg-gradient d-flex align-items-center justify-content-center position-relative" style="height: 200px; background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);">
                                <i class="bi bi-journal-text text-white" style="font-size: 3rem;"></i>
                                <span class="position-absolute top-0 end-0 m-2 premium-badge">
                                    <i class="bi bi-star-fill"></i> Premium
                                </span>
                            </div>
                            {% endif %}

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ article.title }}</h5>

                                <div class="text-muted small mb-3">
                                    <i class="bi bi-calendar"></i> {{ article.publishedAt|date('M j, Y') }}
                                    {% if article.author %}
                                    <span class="ms-3">
                                        <i class="bi bi-person"></i> {{ article.author.firstName }} {{ article.author.lastName }}
                                    </span>
                                    {% endif %}
                                    <span class="ms-3">
                                        <i class="bi bi-clock"></i> {{ article.readingTime ?? '8' }} min read
                                    </span>
                                </div>

                                <p class="card-text">{{ article.excerpt }}</p>

                                <div class="mt-auto">
                                    <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="btn btn-warning text-dark fw-bold">
                                        <i class="bi bi-star-fill"></i> Read Premium Article
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                <nav aria-label="Premium articles pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled">
                            <span class="page-link">Previous</span>
                        </li>
                        <li class="page-item active">
                            <span class="page-link">1</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Next</span>
                        </li>
                    </ul>
                </nav>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-star text-warning" style="font-size: 4rem;"></i>
                    <h3 class="mt-3">No Premium Content Available</h3>
                    <p class="text-muted">New premium articles are being prepared. Check back soon!</p>
                    <a href="{{ path('app_articles') }}" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Browse All Articles
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <!-- Subscription Status -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-crown-fill"></i> Premium Subscriber
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                        <h6 class="mt-2">Access Granted</h6>
                        <p class="mb-3">You have full access to all premium content!</p>
                        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-dark btn-sm">
                            <i class="bi bi-speedometer2"></i> Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>

            <!-- Premium Benefits -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-gift"></i> Premium Benefits</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Unlimited access to premium articles
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Early access to new content
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Downloadable resources
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Ad-free reading experience
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Community access
                        </li>
                        <li class="mb-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Priority customer support
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Content Categories -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-tags-fill"></i> Premium Categories</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Advanced Development
                            <span class="badge bg-warning text-dark rounded-pill">12</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Business Strategy
                            <span class="badge bg-warning text-dark rounded-pill">8</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Industry Insights
                            <span class="badge bg-warning text-dark rounded-pill">15</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Technical Deep Dives
                            <span class="badge bg-warning text-dark rounded-pill">6</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Case Studies
                            <span class="badge bg-warning text-dark rounded-pill">9</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Reading Progress -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Your Reading Progress</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="display-6 fw-bold text-primary">75%</div>
                        <small class="text-muted">Articles completed this month</small>
                    </div>

                    <div class="progress mb-3" style="height: 10px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 75%"></div>
                    </div>

                    <div class="row text-center">
                        <div class="col-6">
                            <div class="fw-bold">18</div>
                            <small class="text-muted">Articles Read</small>
                        </div>
                        <div class="col-6">
                            <div class="fw-bold">6</div>
                            <small class="text-muted">Hours Spent</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}