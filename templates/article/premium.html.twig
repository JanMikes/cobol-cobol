{% extends 'base.html.twig' %}

{% block title %}Prémiový obsah - Čo bol COBOL?{% endblock %}

{% block body %}
<!-- Premium Header -->
<div class="bg-gradient-to-r from-cobol-amber via-cobol-green to-cobol-cyan py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg animate-pulse">
            <i class="fas fa-crown text-cobol-amber text-3xl"></i>
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
            <span class="font-mono">Prémiový</span> obsah
        </h1>
        <p class="text-xl text-white/90 max-w-3xl mx-auto leading-relaxed">
            Exkluzívne články a pokročilé COBOL tutoriály pre našich prémiových predplatiteľov.
            Získajte prístup k najkvalitnejšiemu obsahu v oblasti.
        </p>

        <!-- Premium Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mt-12 max-w-2xl mx-auto">
            <div class="text-center">
                <div class="text-3xl font-bold text-white font-mono">50+</div>
                <div class="text-white/80 text-sm">Exkluzívnych článkov</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-bold text-white font-mono">100+</div>
                <div class="text-white/80 text-sm">Hodín obsahu</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-bold text-white font-mono">24/7</div>
                <div class="text-white/80 text-sm">Prioritná podpora</div>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12">

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-3">
            {% if articles|length > 0 %}
                <div class="flex justify-between items-center mb-8">
                    <h2 class="text-3xl font-bold text-gray-900">Najnovšie prémiové články</h2>
                    <div class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-full font-semibold">
                        <i class="fas fa-lock mr-2"></i>
                        {{ articles|length }} exkluzívnych článkov
                    </div>
                </div>

                <!-- Premium Articles Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                    {% for article in articles %}
                    <article class="group bg-white rounded-xl shadow-lg border-2 border-gradient overflow-hidden hover-lift transition-all duration-300">
                        <!-- Article Image -->
                        <div class="relative">
                            {% if article.featuredImage %}
                            <div class="h-48 overflow-hidden">
                                <img src="{{ article.featuredImage }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt="{{ article.title }}">
                            </div>
                            {% else %}
                            <div class="h-48 bg-gradient-to-br from-cobol-amber to-cobol-green flex items-center justify-center">
                                <i class="fas fa-code text-white text-4xl opacity-80"></i>
                            </div>
                            {% endif %}

                            <!-- Premium Badge -->
                            <div class="absolute top-4 right-4">
                                <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white text-cobol-amber shadow-lg">
                                    <i class="fas fa-crown mr-1"></i>Premium
                                </div>
                            </div>
                        </div>

                        <!-- Article Content -->
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-gray-900 group-hover:text-cobol-amber transition-colors mb-4 line-clamp-2">
                                {{ article.title }}
                            </h3>

                            <!-- Article Meta -->
                            <div class="flex items-center text-sm text-gray-500 mb-4 space-x-4">
                                <div class="flex items-center">
                                    <i class="fas fa-calendar mr-2 text-cobol-cyan"></i>
                                    {{ article.publishedAt|date('M j, Y') }}
                                </div>
                                {% if article.author %}
                                <div class="flex items-center">
                                    <i class="fas fa-user mr-2 text-cobol-cyan"></i>
                                    {{ article.author.firstName }}
                                </div>
                                {% endif %}
                                <div class="flex items-center">
                                    <i class="fas fa-clock mr-2 text-cobol-cyan"></i>
                                    {{ article.readingTime ?? '8' }} min
                                </div>
                            </div>

                            <!-- Excerpt -->
                            <p class="text-gray-600 mb-6 line-clamp-3">{{ article.excerpt }}</p>

                            <!-- Action Button -->
                            <a href="{{ path('app_article_show', {slug: article.slug}) }}" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-cobol-amber to-cobol-green text-white rounded-lg font-semibold hover:from-cobol-green hover:to-cobol-amber transition-all duration-200 transform hover:scale-105 group">
                                <i class="fas fa-crown mr-2"></i>
                                Čítať prémiový článok
                                <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </article>
                    {% endfor %}
                </div>

                <!-- Pagination -->
                <div class="flex justify-center items-center space-x-2">
                    <button class="px-4 py-2 border border-gray-300 text-gray-500 rounded-lg cursor-not-allowed" disabled>
                        <i class="fas fa-chevron-left mr-2"></i>Predchádzajúce
                    </button>
                    <span class="px-4 py-2 bg-cobol-amber text-white rounded-lg font-semibold">1</span>
                    <button class="px-4 py-2 border border-gray-300 text-gray-500 rounded-lg cursor-not-allowed" disabled>
                        Nasledujúce<i class="fas fa-chevron-right ml-2"></i>
                    </button>
                </div>
            {% else %}
                <div class="text-center py-16 bg-white rounded-xl shadow-lg">
                    <div class="w-24 h-24 bg-gradient-to-r from-cobol-amber to-cobol-green rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-crown text-white text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-semibold text-gray-900 mb-4">Žiadny prémiový obsah zatiaľ</h3>
                    <p class="text-gray-600 mb-6">Nové prémiové články sa pripravujú. Skontrolujte neskôr!</p>
                    <a href="{{ path('app_articles') }}" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white rounded-lg font-semibold hover:from-cobol-blue hover:to-cobol-cyan transition-all duration-200">
                        <i class="fas fa-arrow-left mr-2"></i>Všetky články
                    </a>
                </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Subscription Status -->
            <div class="bg-white rounded-xl shadow-lg border-2 border-gradient overflow-hidden">
                <div class="bg-gradient-to-r from-cobol-amber to-cobol-green px-6 py-4 border-b">
                    <h3 class="text-lg font-semibold text-white flex items-center">
                        <i class="fas fa-crown mr-3"></i>
                        Premium predplatiteľ
                    </h3>
                </div>
                <div class="p-6 text-center">
                    <div class="w-16 h-16 bg-gradient-to-r from-cobol-green to-cobol-cyan rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-check text-white text-2xl"></i>
                    </div>
                    <h4 class="text-lg font-semibold text-gray-900 mb-2">Prístup povolený</h4>
                    <p class="text-gray-600 mb-4">Máte plný prístup ku všetkému prémiovému obsahu!</p>
                    <a href="{{ path('app_dashboard') }}" class="inline-flex items-center px-4 py-2 border-2 border-cobol-amber text-cobol-amber rounded-lg font-medium hover:bg-cobol-amber hover:text-white transition-all duration-200">
                        <i class="fas fa-tachometer-alt mr-2"></i>
                        Dashboard
                    </a>
                </div>
            </div>

            <!-- Premium Benefits -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-gift mr-3 text-cobol-green"></i>
                        Premium výhody
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-4">
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-cobol-green mr-3 mt-1"></i>
                            <span class="text-gray-700 text-sm">Neobmedzený prístup k prémiovým článkom</span>
                        </div>
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-cobol-green mr-3 mt-1"></i>
                            <span class="text-gray-700 text-sm">Skorý prístup k novému obsahu</span>
                        </div>
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-cobol-green mr-3 mt-1"></i>
                            <span class="text-gray-700 text-sm">Downloadovateľné zdroje</span>
                        </div>
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-cobol-green mr-3 mt-1"></i>
                            <span class="text-gray-700 text-sm">Čítanie bez reklám</span>
                        </div>
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-cobol-green mr-3 mt-1"></i>
                            <span class="text-gray-700 text-sm">Prístup do komunity</span>
                        </div>
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-cobol-green mr-3 mt-1"></i>
                            <span class="text-gray-700 text-sm">Prioritná zákaznícka podpora</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Categories -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-tags mr-3 text-cobol-amber"></i>
                        Prémiové kategórie
                    </h3>
                </div>
                <div class="p-6">
                    <div class="space-y-3">
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-amber transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-code mr-3 text-cobol-amber group-hover:text-cobol-green"></i>
                                Pokročilý COBOL
                            </span>
                            <span class="bg-cobol-amber text-white px-2 py-1 rounded-full text-xs font-medium">12</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-amber transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-chart-line mr-3 text-cobol-amber group-hover:text-cobol-green"></i>
                                Business stratégie
                            </span>
                            <span class="bg-cobol-amber text-white px-2 py-1 rounded-full text-xs font-medium">8</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-amber transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-lightbulb mr-3 text-cobol-amber group-hover:text-cobol-green"></i>
                                Odborné poznatky
                            </span>
                            <span class="bg-cobol-amber text-white px-2 py-1 rounded-full text-xs font-medium">15</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-amber transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-cogs mr-3 text-cobol-amber group-hover:text-cobol-green"></i>
                                Technické analýzy
                            </span>
                            <span class="bg-cobol-amber text-white px-2 py-1 rounded-full text-xs font-medium">6</span>
                        </a>
                        <a href="#" class="flex items-center justify-between text-gray-700 hover:text-cobol-amber transition-colors group">
                            <span class="flex items-center">
                                <i class="fas fa-building mr-3 text-cobol-amber group-hover:text-cobol-green"></i>
                                Prípadové štúdie
                            </span>
                            <span class="bg-cobol-amber text-white px-2 py-1 rounded-full text-xs font-medium">9</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Reading Progress -->
            <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                        <i class="fas fa-chart-bar mr-3 text-cobol-blue"></i>
                        Váš pokrok v čítaní
                    </h3>
                </div>
                <div class="p-6">
                    <div class="text-center mb-6">
                        <div class="text-4xl font-bold text-cobol-amber mb-2">75%</div>
                        <p class="text-gray-600 text-sm">Dokončených článkov tento mesiac</p>
                    </div>

                    <div class="w-full bg-gray-200 rounded-full h-3 mb-6">
                        <div class="bg-gradient-to-r from-cobol-amber to-cobol-green h-3 rounded-full transition-all duration-300" style="width: 75%"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 text-center">
                        <div>
                            <div class="text-2xl font-bold text-gray-900">18</div>
                            <p class="text-gray-600 text-xs">Prečítaných článkov</p>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900">6</div>
                            <p class="text-gray-600 text-xs">Strávených hodín</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}