{% extends 'base.html.twig' %}

{% block title %}Prihlásenie - Čo bol COBOL?{% endblock %}

{% block body %}
<!-- Login Page -->
<div class="min-h-screen bg-gradient-to-br from-cobol-navy via-cobol-blue to-cobol-cyan flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <!-- Header -->
        <div class="text-center">
            <div class="flex items-center justify-center mb-6">
                <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-lg">
                    <i class="fas fa-terminal text-cobol-navy text-2xl"></i>
                </div>
            </div>
            <h2 class="text-3xl font-bold text-white mb-2">Vitajte späť!</h2>
            <p class="text-white/80">Prihláste sa do svojho účtu</p>
        </div>

        <!-- Login Form -->
        <div class="bg-white rounded-2xl shadow-2xl p-8">
            {% if error %}
                <div class="mb-6 p-4 rounded-lg border-l-4 border-red-400 bg-red-50">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-exclamation-triangle text-red-400"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-red-700">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <form method="post" class="space-y-6">
                <!-- Email Field -->
                <div>
                    <label for="inputEmail" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-envelope mr-2 text-cobol-cyan"></i>
                        Email adresa
                    </label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="inputEmail"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cobol-cyan focus:border-transparent transition-all duration-200"
                           placeholder="vas@email.com"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <!-- Password Field -->
                <div>
                    <label for="inputPassword" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-lock mr-2 text-cobol-cyan"></i>
                        Heslo
                    </label>
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cobol-cyan focus:border-transparent transition-all duration-200"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center justify-between">
                    <label class="flex items-center">
                        <input type="checkbox" name="_remember_me" id="remember_me" class="w-4 h-4 text-cobol-cyan border-gray-300 rounded focus:ring-cobol-cyan">
                        <span class="ml-2 text-sm text-gray-700">Zapamätať si ma</span>
                    </label>
                    <a href="#" class="text-sm text-cobol-cyan hover:text-cobol-blue transition-colors">
                        Zabudli ste heslo?
                    </a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-cobol-cyan to-cobol-blue text-white py-3 px-4 rounded-lg font-semibold text-lg hover:from-cobol-blue hover:to-cobol-cyan transition-all duration-200 transform hover:scale-105 shadow-lg">
                    <i class="fas fa-sign-in-alt mr-2"></i>
                    Prihlásiť sa
                </button>
            </form>

            <!-- Divider -->
            <div class="my-8">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">Alebo</span>
                    </div>
                </div>
            </div>

            <!-- Register Link -->
            <div class="text-center">
                <p class="text-gray-600 mb-4">Nemáte ešte účet?</p>
                <a href="{{ path('app_register') }}" class="inline-flex items-center px-6 py-3 border-2 border-cobol-cyan text-cobol-cyan rounded-lg font-semibold hover:bg-cobol-cyan hover:text-white transition-all duration-200 transform hover:scale-105">
                    <i class="fas fa-user-plus mr-2"></i>
                    Vytvoriť účet
                </a>
            </div>
        </div>

        <!-- Additional Links -->
        <div class="text-center">
            <a href="{{ path('app_home') }}" class="inline-flex items-center text-white/80 hover:text-white transition-colors">
                <i class="fas fa-arrow-left mr-2"></i>
                Späť na úvod
            </a>
        </div>
    </div>
</div>
{% endblock %}